{
  "name": "wicka-assistance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Site Wicka Assistance : Hono + TypeScript (JSX), compatible Cloudflare Workers et Vercel",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:vercel": "vercel dev",
    "build": "npm run typecheck && npm run build:vercel",
    "typecheck": "tsc --noEmit",
    "build:vercel": "esbuild src/vercel-handler.ts --bundle --platform=node --format=esm --outfile=api/index.js"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
